        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "📁 Results Path: /content/drive/My Drive/Swat_Snow_Cover_Project/Final_Results/TransUNet_ResNet50_ViT\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "CONFIG = {\n",
        "    \"model_name\": MODEL_NAME,\n",
        "    \"num_epochs\": 50,\n",
        "    \"batch_size\": 8,\n",
        "    \"learning_rate\": 1e-4,\n",
        "    \"num_workers\": 0,\n",
        "    \"total_patches\": 5000\n",
        "}\n",
        "\n",
        "CONFIG[\"train_size\"] = int(CONFIG[\"total_patches\"] * 0.7)\n",
        "CONFIG[\"val_size\"] = int(CONFIG[\"total_patches\"] * 0.2)\n",
        "CONFIG[\"test_size\"] = CONFIG[\"total_patches\"] - CONFIG[\"train_size\"] - CONFIG[\"val_size\"]\n",
        "\n",
        "train_batches = CONFIG[\"train_size\"] // CONFIG[\"batch_size\"]\n",
        "val_batches = CONFIG[\"val_size\"] // CONFIG[\"batch_size\"]\n",
        "\n",
        "print(f\"📊 Train/Val/Test Split: {CONFIG['train_size']}/{CONFIG['val_size']}/{CONFIG['test_size']}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "PoAbnLxwO7WP",
        "outputId": "12e6fbbb-04ac-498e-b46c-dcec7b9690d8"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "📊 Train/Val/Test Split: 3500/1000/500\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "train_transform = A.Compose([\n",
        "    A.Resize(256, 256),\n",
        "    A.HorizontalFlip(p=0.5),\n",
        "    A.VerticalFlip(p=0.5),\n",
        "    A.RandomRotate90(p=0.5),\n",
        "    A.ShiftScaleRotate(shift_limit=0.1, scale_limit=0.2, rotate_limit=30, p=0.5),\n",
        "    A.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),\n",
        "    ToTensorV2(),\n",
        "])\n",
        "\n",
        "val_transform = A.Compose([\n",
        "    A.Resize(256, 256),\n",
        "    A.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),\n",
        "    ToTensorV2(),\n",
        "])\n",
        "\n",
        "def preprocess_sample(sample, transform):\n",
        "    img = np.array(sample[\"image.png\"].convert(\"RGB\"))\n",
        "    msk = np.array(sample[\"mask.png\"].convert(\"L\")) / 255.0\n",
        "    t = transform(image=img, mask=msk)\n",
        "    return t[\"image\"], t[\"mask\"].unsqueeze(0)"
      ],
      "metadata": {
        "id": "mYbIudxrO-WT"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "train_dataset = (wds.WebDataset(wds_path)\n",
        "    .shuffle(1000).decode(\"pil\").to_tuple(\"image.png\", \"mask.png\")\n",
        "    .map(lambda x: preprocess_sample({\"image.png\": x[0], \"mask.png\": x[1]}, train_transform))\n",
        "    .batched(CONFIG[\"batch_size\"]))\n",
        "\n",
        "val_dataset = (wds.WebDataset(wds_path)\n",
        "    .decode(\"pil\").to_tuple(\"image.png\", \"mask.png\")\n",
        "    .map(lambda x: preprocess_sample({\"image.png\": x[0], \"mask.png\": x[1]}, val_transform))\n",
        "    .batched(CONFIG[\"batch_size\"]))\n",
        "\n",
        "train_loader = wds.WebLoader(train_dataset, batch_size=None).with_epoch(train_batches)\n",
        "val_loader = wds.WebLoader(val_dataset, batch_size=None).with_epoch(val_batches)\n",
        "\n",
        "print(\"✅ Data loaders ready!\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "32SI4UB8PA_u",
        "outputId": "66fc7e27-42e7-4af9-e109-0318ed751177"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "✅ Data loaders ready!\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "class TransUNet(nn.Module):\n",
        "    def __init__(self, out_channels=1):\n",
        "        super().__init__()\n",
        "        # 1. ResNet-50 Encoder (First 3 stages)\n",
        "        resnet = timm.create_model('resnet50', pretrained=True, features_only=True)\n",
        "        self.cnn_encoder = resnet\n",
        "\n",
        "        # 2. Vision Transformer Bottleneck\n",
        "        # The CNN reduces 256x256 -> 16x16. With 2048 channels.\n",
        "        self.vit = timm.create_model('vit_base_patch16_224', pretrained=True, num_classes=0)\n",
        "\n",
        "        # Adjust ViT for 16x16 input from CNN (which is 256 patches)\n",
        "        self.vit.patch_embed = nn.Conv2d(2048, 768, kernel_size=1)\n",
        "        # Interpolate PosEmbed for 16x16 grid (256 patches + 1 cls token)\n",
        "        old_pos = self.vit.pos_embed\n",
        "        cls_token = old_pos[:, :1, :]\n",
        "        spatial_pos = F.interpolate(old_pos[:, 1:, :].reshape(1, 14, 14, 768).permute(0,3,1,2),\n",
        "                                    size=(16, 16), mode='bicubic').permute(0,2,3,1).reshape(1, 256, 768)\n",
        "        self.vit.pos_embed = nn.Parameter(torch.cat([cls_token, spatial_pos], dim=1))\n",
        "\n",
        "        # 3. Decoder Stages\n",
        "        self.up1 = nn.ConvTranspose2d(768, 512, 2, 2)\n",
        "        self.up2 = nn.ConvTranspose2d(512, 256, 2, 2)\n",
        "        self.up3 = nn.ConvTranspose2d(256, 128, 2, 2)\n",
        "        self.up4 = nn.ConvTranspose2d(128, 64, 2, 2)\n",
        "        self.final_conv = nn.Conv2d(64, out_channels, 1)\n",
        "\n",
        "    def forward(self, x):\n",
        "        # CNN Features\n",
        "        features = self.cnn_encoder(x) # [1/4, 1/8, 1/16, 1/32]\n",
        "        c4 = features[-1] # Shape: [B, 2048, 8, 8] - Wait, for 256 it's [B, 2048, 8, 8]\n",
        "        # For 256x256, let's use 1/16 features for ViT to get a 16x16 grid\n",
        "        c3 = features[-2] # Shape: [B, 1024, 16, 16]\n",
        "\n",
        "        # Transformer Bottleneck\n",
        "        z = self.vit.patch_embed(features[-1]) # Down to 8x8...\n",
        "        # To match TransUNet paper, we feed the deep CNN features to ViT\n",
        "        z = features[-1]\n",
        "        # Let's adjust for spatial consistency:\n",
        "        z = F.interpolate(z, size=(16,16), mode='bilinear') # Ensure 16x16 grid\n",
        "        z = self.vit.patch_embed(z).flatten(2).transpose(1, 2)\n",
        "        z = self.vit.pos_drop(z + self.vit.pos_embed[:, 1:, :])\n",
        "        for block in self.vit.blocks:\n",
        "            z = block(z)\n",
        "        z = z.transpose(1, 2).reshape(-1, 768, 16, 16)\n",
        "\n",
        "        # Decoder\n",
        "        d1 = F.relu(self.up1(z))    # 16->32\n",
        "        d2 = F.relu(self.up2(d1))   # 32->64\n",
        "        d3 = F.relu(self.up3(d2))   # 64->128\n",
        "        d4 = F.relu(self.up4(d3))   # 128->256\n",
        "        return self.final_conv(d4)\n",
        "\n",
        "model = TransUNet().to(device)\n",
        "print(f\"✅ TransUNet Built! Params: {sum(p.numel() for p in model.parameters()):,}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
