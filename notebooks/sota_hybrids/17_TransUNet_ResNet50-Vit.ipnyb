    {
      "cell_type": "code",
      "source": [
        "class DiceBCELoss(nn.Module):\n",
        "    def __init__(self): super().__init__(); self.bce = nn.BCEWithLogitsLoss()\n",
        "    def forward(self, pred, target):\n",
        "        bce = self.bce(pred, target)\n",
        "        p = torch.sigmoid(pred)\n",
        "        inter = (p * target).sum()\n",
        "        dice = 1 - (2 * inter + 1e-6) / (p.sum() + target.sum() + 1e-6)\n",
        "        return 0.5 * bce + 0.5 * dice\n",
        "\n",
        "def calc_metrics(pred, target, thr=0.5):\n",
        "    pred = (torch.sigmoid(pred) > thr).float()\n",
        "    inter = (pred * target).sum()\n",
        "    union = pred.sum() + target.sum() - inter\n",
        "    dice = (2 * inter + 1e-6) / (pred.sum() + target.sum() + 1e-6)\n",
        "    iou = (inter + 1e-6) / (union + 1e-6)\n",
        "    return iou, dice\n",
        "\n",
        "criterion = DiceBCELoss()\n",
        "optimizer = torch.optim.AdamW(model.parameters(), lr=CONFIG[\"learning_rate\"])\n",
        "scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode=\"min\", patience=5, factor=0.5)\n",
        "\n",
        "history = {k: [] for k in [\"train_loss\", \"val_loss\", \"train_iou\", \"val_iou\", \"train_dice\", \"val_dice\", \"learning_rate\"]}\n",
        "best_dice = 0.0"
      ],
      "metadata": {
        "id": "8tX3_HquPG9M"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def train_epoch(model, loader, num_batches):\n",
        "    model.train()\n",
        "    m = {\"loss\": [], \"iou\": [], \"dice\": []}\n",
        "    pbar = tqdm(enumerate(loader), total=num_batches, desc=\"Train\")\n",
        "    for bi, (imgs, msks) in pbar:\n",
        "        if bi >= num_batches: break\n",
        "        imgs, msks = imgs.to(device), msks.to(device)\n",
        "        optimizer.zero_grad()\n",
        "        preds = model(imgs)\n",
        "        loss = criterion(preds, msks)\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "        iou, dice = calc_metrics(preds, msks)\n",
        "        m[\"loss\"].append(loss.item())\n",
        "        m[\"iou\"].append(iou.item()); m[\"dice\"].append(dice.item())\n",
        "        pbar.set_postfix(loss=f\"{np.mean(m['loss']):.4f}\", dice=f\"{np.mean(m['dice']):.4f}\")\n",
        "    return {k: np.mean(v) for k, v in m.items()}\n",
        "\n",
        "def val_epoch(model, loader, num_batches):\n",
        "    model.eval()\n",
        "    m = {\"loss\": [], \"iou\": [], \"dice\": []}\n",
        "    with torch.no_grad():\n",
        "        for bi, (imgs, msks) in enumerate(loader):\n",
        "            if bi >= num_batches: break\n",
        "            imgs, msks = imgs.to(device), msks.to(device)\n",
        "            preds = model(imgs)\n",
        "            loss = criterion(preds, msks)\n",
        "            iou, dice = calc_metrics(preds, msks)\n",
        "            m[\"loss\"].append(loss.item())\n",
        "            m[\"iou\"].append(iou.item()); m[\"dice\"].append(dice.item())\n",
        "    return {k: np.mean(v) for k, v in m.items()}"
      ],
      "metadata": {
        "id": "SDnSHNdXPNb2"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"🚀 TRAINING START\")\n",
        "for epoch in range(CONFIG[\"num_epochs\"]):\n",
        "    print(f\"\\nEpoch {epoch+1}/{CONFIG['num_epochs']}\")\n",
        "    train_m = train_epoch(model, train_loader, train_batches)\n",
        "    val_m = val_epoch(model, val_loader, val_batches)\n",
        "\n",
        "    scheduler.step(val_m[\"loss\"])\n",
        "    lr = optimizer.param_groups[0][\"lr\"]\n",
        "\n",
        "    for k in train_m.keys():\n",
        "        history[f\"train_{k}\"].append(train_m[k])\n",
        "        history[f\"val_{k}\"].append(val_m[k])\n",
        "    history[\"learning_rate\"].append(lr)\n",
        "\n",
        "    if val_m[\"dice\"] > best_dice:\n",
        "        best_dice = val_m[\"dice\"]\n",
        "        torch.save(model.state_dict(), os.path.join(model_results_path, \"best_model.pth\"))\n",
        "        print(f\"  ⭐ NEW BEST VAL DICE: {best_dice:.4f}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "5YBD-4gsPQHK",
        "outputId": "1466f3dd-5dfb-459d-946a-f59c8aa52c14"
      },
      "execution_count": null,
      "outputs": [
        {
          "metadata": {
            "tags": null
          },
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "🚀 TRAINING START\n",
            "\n",
            "Epoch 1/50\n"
          ]
