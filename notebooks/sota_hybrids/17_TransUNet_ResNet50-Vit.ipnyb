      "cell_type": "code",
      "source": [
        "epochs_range = np.arange(1, len(history[\"train_loss\"]) + 1)\n",
        "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
        "\n",
        "for i, (m, title) in enumerate([(\"loss\", \"Loss\"), (\"dice\", \"Dice\"), (\"iou\", \"IoU\")]):\n",
        "    row, col = divmod(i, 2)\n",
        "    axes[row, col].plot(epochs_range, history[f\"train_{m}\"], \"o-\", label=\"Train\")\n",
        "    axes[row, col].plot(epochs_range, history[f\"val_{m}\"], \"s-\", label=\"Val\")\n",
        "    axes[row, col].set_title(title, fontweight=\"bold\")\n",
        "    axes[row, col].legend(); axes[row, col].grid(alpha=0.3)\n",
        "\n",
        "axes[1, 1].plot(epochs_range, history[\"learning_rate\"], \"o-\", color=\"purple\")\n",
        "axes[1, 1].set_title(\"Learning Rate\", fontweight=\"bold\"); axes[1, 1].set_yscale(\"log\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(os.path.join(model_results_path, \"training_curves.png\"), dpi=300)\n",
        "plt.show()"
