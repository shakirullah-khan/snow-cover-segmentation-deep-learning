    {
      "cell_type": "code",
      "source": [
        "model.load_state_dict(torch.load(os.path.join(model_results_path, \"best_model.pth\")))\n",
        "model.eval()\n",
        "raw_ds = list(wds.WebDataset(wds_path).decode(\"pil\").to_tuple(\"image.png\", \"mask.png\"))\n",
        "test_indices = random.sample(range(4500, 5000), 8)\n",
        "\n",
        "fig, axes = plt.subplots(8, 3, figsize=(15, 40))\n",
        "with torch.no_grad():\n",
        "    for i, idx in enumerate(test_indices):\n",
        "        img_p, msk_p = raw_ds[idx]\n",
        "        img_np = np.array(img_p.convert(\"RGB\"))\n",
        "        msk_np = np.array(msk_p.convert(\"L\")) / 255.0\n",
        "        img_t = val_transform(image=img_np, mask=msk_np)[\"image\"].unsqueeze(0).to(device)\n",
        "        pred = (torch.sigmoid(model(img_t)) > 0.5).squeeze().cpu().numpy()\n",
        "\n",
        "        axes[i, 0].imshow(img_np); axes[i, 0].set_title(f\"Original {idx}\"); axes[i, 0].axis(\"off\")\n",
        "        axes[i, 1].imshow(msk_np, cmap='gray'); axes[i, 1].set_title(\"Ground Truth\"); axes[i, 1].axis(\"off\")\n",
        "        axes[i, 2].imshow(pred, cmap='gray'); axes[i, 2].set_title(\"Prediction\"); axes[i, 2].axis(\"off\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(os.path.join(model_results_path, \"viz.png\"), dpi=300)\n",
        "plt.show()"
      ],
