    {
      "cell_type": "code",
      "source": [
        "MODEL_NAME = \"TransUNet_ResNet50_ViT\"\n",
        "final_results_path = \"/content/drive/My Drive/Swat_Snow_Cover_Project/Final_Results\"\n",
